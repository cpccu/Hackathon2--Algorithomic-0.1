# ==================================================
# CampusOS — Environment Configuration Template
# City University Digital Campus Platform
# ==================================================
# Copy this file to .env.local to configure your local development environment.
# DO NOT commit real API keys, secrets, or passwords to source control.

# Application Base
NEXT_PUBLIC_APP_NAME="CampusOS — City University"
NEXT_PUBLIC_APP_TAGLINE="One Campus. One Platform. Everything You Need."
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --------------------------------------------------
# STEP 3 — Database & Persistent Data Storage
# --------------------------------------------------
# PostgreSQL connection string (Neon, Supabase, AWS RDS, Docker, or local Postgres)
DATABASE_URL="postgres://postgres:password@localhost:5432/campusos"

# Optional SSL toggle for cloud-hosted PostgreSQL instances
DATABASE_SSL="false"

# --------------------------------------------------
# STEP 2 — Authentication Security
# --------------------------------------------------
# Cryptographic secret for signing session tokens and hashing OTPs (32+ chars recommended)
AUTH_SECRET="your-cryptographic-32-character-secret-salt-here"

# --------------------------------------------------
# STEP 2 — Transactional Email Delivery (SMTP)
# --------------------------------------------------
# Standard SMTP configuration (Gmail, Outlook, Resend, SendGrid, Amazon SES, or university relay)
# For Gmail: Use smtp.gmail.com with port 587 and an App Password from your Google Account
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_SECURE="false"
SMTP_SERVICE="gmail"
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-16-digit-app-password"
SMTP_FROM="CampusOS <noreply@campusos.cityuniversity.edu>"

# --------------------------------------------------
# STEP 8 — CampusOS Smart Helpdesk (Grounded AI Assistant)
# --------------------------------------------------
# Google Gemini API Key from Google AI Studio (https://aistudio.google.com)
GEMINI_API_KEY="your-gemini-api-key"
